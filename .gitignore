# Curated publication: root paths and inference-only model exceptions are deliberate.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/AGENTS.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/requirements-demo.txt
!/requirements-models.txt
!/jepa-runtime.example.toml
!/code/
!/scripts/
!/docs/
!/models/

# Curated documentation only; local reports can contain private provenance.
/docs/*
!/docs/RUNNING.md
!/docs/PROJECT_STATUS.md
!/docs/REPOSITORY_GUIDE.md
!/docs/RESOURCE_SETUP.md
!/docs/REPRODUCIBLE_RELEASE.md
/models/*
!/models/README.md

# Owner-approved exception: two reviewed inference-only readouts, never originals.
!/models/public/
/models/public/*
!/models/public/locator.json
!/models/public/motion.json
!/models/public/registry.json
!/models/public/LICENSE

# Third-party copies need separate provenance and license review.
/code/depth_anything_v2/

# Local Python/runtime artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/

# Secrets, local state and user/media assets are never source artifacts.
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*.log
*.sqlite
*.sqlite3
*.db
*.pkl
*.pickle
*.pt
*.pth
*.safetensors
*.npz
*.npy
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.zip
*.7z
*.tar
*.gz
.DS_Store
Thumbs.db
